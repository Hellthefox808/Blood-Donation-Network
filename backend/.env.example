# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with PostGIS or local SQLite file)
DATABASE_URL="file:./dev.db"

# JWT Secret Key (Use a strong 64-character random string in production)
JWT_SECRET="your_jwt_secret_key_here"

# Communications Gateway Configuration (Twilio & SendGrid)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+18005550199"
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="notifications@yourdomain.org"

# Mapping & Distance Matrix APIs
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
